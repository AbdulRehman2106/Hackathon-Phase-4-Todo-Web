# Example Kubernetes Secrets Configuration
# DO NOT commit this file with real values to version control
# Copy this file to k8s-secrets.yaml and fill in your actual values
# Then apply with: kubectl apply -f k8s-secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: todo-app-secrets
  namespace: todo-app
  labels:
    app: todo-app
type: Opaque
stringData:
  # Database connection string
  # Format: postgresql://username:password@host:port/database
  DATABASE_URL: "postgresql://user:password@localhost:5432/todo_db"

  # JWT Secret Key for authentication
  # Generate with: openssl rand -hex 32
  JWT_SECRET_KEY: "your-secret-key-here-replace-with-actual-secret"

  # Cohere API Key (optional, for AI features)
  # Get from: https://dashboard.cohere.ai/api-keys
  COHERE_API_KEY: "your-cohere-api-key-here"
