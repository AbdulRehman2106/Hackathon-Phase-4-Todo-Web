# Kubernetes Secrets Template for Phase IV Deployment
# This file provides a template for creating Kubernetes Secrets
# DO NOT commit actual secrets to version control

# ============================================================================
# USAGE INSTRUCTIONS
# ============================================================================
#
# Method 1: Using kubectl (Recommended)
# This method automatically handles base64 encoding:
#
# kubectl create secret generic backend-secrets \
#   --from-literal=database_url="postgresql://user:pass@host:5432/db?sslmode=require" \
#   --from-literal=cohere_api_key="your-cohere-api-key" \
#   --from-literal=jwt_secret="your-jwt-secret"
#
# Method 2: From environment variables
#
# kubectl create secret generic backend-secrets \
#   --from-literal=database_url="$DATABASE_URL" \
#   --from-literal=cohere_api_key="$COHERE_API_KEY" \
#   --from-literal=jwt_secret="$JWT_SECRET"
#
# Method 3: From .env file
#
# kubectl create secret generic backend-secrets --from-env-file=.env.secrets
#
# ============================================================================

# ============================================================================
# MANUAL YAML CREATION (Not Recommended)
# ============================================================================
# If you must create YAML manually, follow these steps:
#
# 1. Base64 encode each value:
#    echo -n "your-value-here" | base64
#
# 2. Replace the placeholders below with encoded values
#
# 3. Apply the secret:
#    kubectl apply -f k8s-secrets.yaml
#
# WARNING: Never commit this file with actual values to Git!
# ============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
  namespace: default
  labels:
    app: todo-backend
    component: backend
    tier: application
type: Opaque
data:
  # Base64-encoded database connection string
  # Example: postgresql://user:password@host:5432/dbname?sslmode=require
  database_url: <BASE64_ENCODED_DATABASE_URL>

  # Base64-encoded Cohere API key
  # Obtain from: https://dashboard.cohere.com/api-keys
  cohere_api_key: <BASE64_ENCODED_COHERE_API_KEY>

  # Base64-encoded JWT secret for authentication
  # Generate with: openssl rand -base64 32
  jwt_secret: <BASE64_ENCODED_JWT_SECRET>

# ============================================================================
# VERIFICATION
# ============================================================================
# After creating the secret, verify it exists:
#
# kubectl get secret backend-secrets
# kubectl describe secret backend-secrets
#
# To decode and view values (for debugging only):
#
# kubectl get secret backend-secrets -o jsonpath='{.data.database_url}' | base64 --decode
# kubectl get secret backend-secrets -o jsonpath='{.data.cohere_api_key}' | base64 --decode
# kubectl get secret backend-secrets -o jsonpath='{.data.jwt_secret}' | base64 --decode
#
# ============================================================================

# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================
# ✅ DO:
#   - Use kubectl create secret (automatic encoding)
#   - Store secrets in password manager
#   - Use different secrets per environment
#   - Rotate secrets regularly
#   - Add k8s-secrets.yaml to .gitignore
#   - Use RBAC to restrict secret access
#   - Enable etcd encryption at rest
#
# ❌ DON'T:
#   - Commit secrets to Git
#   - Share secrets in chat/email
#   - Reuse secrets across environments
#   - Use weak JWT secrets
#   - Log secret values
#   - Include secrets in container images
# ============================================================================

# ============================================================================
# EXAMPLE VALUES (for reference only)
# ============================================================================
# These are example formats - replace with your actual values
#
# DATABASE_URL format:
#   postgresql://[user]:[password]@[host]:[port]/[database]?[options]
#   Example: postgresql://todouser:securepass@db.example.com:5432/tododb?sslmode=require
#
# COHERE_API_KEY format:
#   Alphanumeric string, typically 40+ characters
#   Example: abc123def456ghi789jkl012mno345pqr678stu901
#
# JWT_SECRET format:
#   Generate with: openssl rand -base64 32
#   Example: 8Zz5tw0Ionm3XPZZfN0NOml3z9FMfmpgXwovR9fp6ryDIoGRM8EPHAB6iHsc0fb
# ============================================================================
